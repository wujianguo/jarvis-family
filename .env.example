# Public configuration
WECHAT_MINI_APPID=wx_your_public_app_id
WECHAT_MINI_ORIGINAL_ID=gh_your_public_original_id
ADMIN_EMAIL=admin@example.com
DEPLOY_HOST=your-server.example
PUBLIC_ORIGIN=https://your-domain.example
PUBLIC_API_BASE=https://your-domain.example/family/api
BETTER_AUTH_URL=https://your-domain.example/family/api/auth
# The Web basePath is /family (apps/web/next.config.ts).

# Server-only values: set on ECS or in CI; never commit real values.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/database
BETTER_AUTH_SECRET=replace_with_random_secret
WECHAT_MINI_SECRET=replace_with_server_only_secret
SMS_INGEST_TOKEN=replace_with_random_token
SMS_AI_BASE_URL=https://your-ai-endpoint.example/v1
SMS_AI_MODEL=your-model
SMS_AI_API_KEY=replace_with_server_only_key
